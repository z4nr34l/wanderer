# Promo codes for map subscriptions (optional)
# Format: CODE:DISCOUNT_PERCENT,CODE2:DISCOUNT_PERCENT2
# Codes are case-insensitive, discounts stack with period discounts
# export WANDERER_PROMO_CODES="PROMO2025:10,NEWUSER:20"

# Discord account linking (optional).
# A Discord OAuth application. With these set, people can link a Discord account on /characters
# and the team can see which character belongs to whom. Redirect URI defaults to
# "$WEB_APP_URL/characters/discord/callback" and must be registered on the Discord application.
# export WANDERER_DISCORD_CLIENT_ID="<DISCORD_CLIENT_ID>"
# export WANDERER_DISCORD_CLIENT_SECRET="<DISCORD_CLIENT_SECRET>"
# export WANDERER_DISCORD_REDIRECT_URI="http://localhost:8000/characters/discord/callback"
#
# Discord role access lists additionally need a bot in the server, with the Server Members
# intent, because roles are read from the guild rather than from the person. Without this the
# Discord role members of an access list grant nothing.
# export WANDERER_DISCORD_BOT_TOKEN="<DISCORD_BOT_TOKEN>"
